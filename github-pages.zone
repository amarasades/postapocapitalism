; GitHub Pages DNS records for Cloudflare import
; Cloudflare dashboard -> your domain -> DNS -> Records -> Import and Export -> Import
; Names are relative ("@" = the bare domain), so this works for whatever domain you import it into.
; Pages site owner: amarasades (www points at amarasades.github.io)
;
; cf_tags=cf-proxied:false = grey cloud (DNS only). Keep it that way until GitHub
; has issued its HTTPS certificate, or the certificate request will fail.

$TTL 3600

; Apex: GitHub Pages IPv4
@	IN	A	185.199.108.153	; cf_tags=cf-proxied:false
@	IN	A	185.199.109.153	; cf_tags=cf-proxied:false
@	IN	A	185.199.110.153	; cf_tags=cf-proxied:false
@	IN	A	185.199.111.153	; cf_tags=cf-proxied:false

; Apex: GitHub Pages IPv6
@	IN	AAAA	2606:50c0:8000::153	; cf_tags=cf-proxied:false
@	IN	AAAA	2606:50c0:8001::153	; cf_tags=cf-proxied:false
@	IN	AAAA	2606:50c0:8002::153	; cf_tags=cf-proxied:false
@	IN	AAAA	2606:50c0:8003::153	; cf_tags=cf-proxied:false

; www -> GitHub user site
www	IN	CNAME	amarasades.github.io.	; cf_tags=cf-proxied:false
